bin/
obj/
node_modules/
dist/
*.user
.vs/
.vscode/
desktop.ini
*.world
!worlds/*/manifest.json
AppData/
*.log
coverage/

# Vite build output. This is generated, and tracking it caused a real bug: the
# native host loads index.html from disk, so a stale committed bundle shipped
# code that no longer matched the source.
src/Engine/renderer/

# Generated showcase and preview renders. Regenerate with `node tools/showcase.mjs`.
build/
!build/.gitkeep

tools/node_modules/

# NOTE: tools/package.json is intentionally tracked. The verification and
# showcase scripts need Playwright, and ignoring the manifest made them
# unrunnable for anyone who cloned the repo.

# Credentials. `.env` holds real keys, `.env.example` is the tracked template and
# must always be empty, so the negation has to come after the catch-all. Without
# this rule a `.env` is a plain untracked-looking file that `git add -A` sweeps up,
# and the leak is only noticed after it is public.
.env
.env.*
!.env.example

