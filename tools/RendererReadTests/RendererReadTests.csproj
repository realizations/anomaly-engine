<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Regression test for a crash that took the application down.

    Opening the settings window killed Anomaly Engine. `ExecuteScriptAsync` does not
    throw when the evaluated script fails; it returns the failure as a JSON string, which
    parses cleanly and then throws at the first `EnumerateArray`. That exception reached
    the window's load path unhandled, was rethrown on the dispatcher, and ended the
    process.

    Its own project rather than folded into another harness, because it needs no network,
    no listener and nothing else: it is a pure reader meeting the payloads WebView2
    actually returns, and it should be runnable on its own the moment that behaviour is
    suspected again.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RendererReadTests</AssemblyName>
    <RootNamespace>RendererReadTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AnomalyEngine\AnomalyEngine.csproj" />
  </ItemGroup>

</Project>