<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>AnomalyEngine</RootNamespace>
    <AssemblyName>AnomalyEngine</AssemblyName>
    <Version>0.1.0</Version>
    <Authors>Ali S.</Authors>
    <Product>Anomaly Engine</Product>
    <Description>A live wallpaper engine where the desktop behaves like a living world.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <RendererFiles Include="..\Engine\renderer\**\*" Condition="Exists('..\Engine\renderer\index.html')" />
  </ItemGroup>

  <Target Name="BuildRenderer" BeforeTargets="Build">
    <Exec Command="npm run build" WorkingDirectory="..\Engine" Condition="Exists('..\Engine\package.json')" />
  </Target>

  <Target Name="CopyRendererFiles" AfterTargets="Build">
    <Copy SourceFiles="@(RendererFiles)" DestinationFiles="@(RendererFiles->'$(OutDir)renderer\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\Engine\src\index.html" DestinationFiles="$(OutDir)renderer\index.html" SkipUnchangedFiles="true" />
  </Target>

</Project>
