<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>AnomalyEngine</RootNamespace>
    <AssemblyName>AnomalyEngine</AssemblyName>
    <Version>0.1.0</Version>
    <Authors>Ali S.</Authors>
    <Product>Anomaly Engine</Product>
    <Description>A live wallpaper engine where the desktop behaves like a living world.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
  </ItemGroup>

  <!--
    Typefaces are embedded as WPF resources rather than read from disk, so the
    settings window renders correctly from any working directory and cannot end
    up silently falling back to Segoe UI on a machine that happens to lack the
    font. All are SIL OFL and unmodified, so embedding them is permitted; see
    assets/manifest.json for the full provenance record.
  -->
  <ItemGroup>
    <Resource Include="..\..\assets\fonts\Inter-Regular.ttf">
      <Link>Fonts\Inter-Regular.ttf</Link>
    </Resource>
<Resource Include="..\..\assets\fonts\Inter-SemiBold.ttf">
      <Link>Fonts\Inter-SemiBold.ttf</Link>
    </Resource>
    <Resource Include="..\..\assets\fonts\SpaceGrotesk-Medium.ttf">
      <Link>Fonts\SpaceGrotesk-Medium.ttf</Link>
    </Resource>
    <Resource Include="..\..\assets\fonts\SpaceGrotesk-Bold.ttf">
      <Link>Fonts\SpaceGrotesk-Bold.ttf</Link>
    </Resource>
    <Resource Include="..\..\assets\fonts\IBMPlexMono-Regular.ttf">
      <Link>Fonts\IBMPlexMono-Regular.ttf</Link>
    </Resource>
  </ItemGroup>

  <!--
    Renderer sources are listed as inputs to the C# project for documentation and
    for tools that want to know the dependency. They are deliberately *not* wired
    into an incremental check; see the comment on BuildRenderer.
  -->
  <ItemGroup>
    <EngineRendererSource Include="..\Engine\src\**\*" />
    <EngineRendererConfig Include="..\Engine\package.json;..\Engine\package-lock.json;..\Engine\tsconfig.json;..\Engine\vite.config.ts" />
  </ItemGroup>

  <!--
    Builds the renderer bundle. Always, not incrementally.

    An earlier version of this hooked the target to Build with Inputs/Outputs on a
    stamp file, so that a change to a .cs file would not pay for a vite build. That
    is the right idea and it is wrong here, because MSBuild decides staleness from
    file timestamps only: restoring a file from a backup or a branch keeps its old
    mtime, the target is skipped, and the build deploys a bundle that does not
    match the source. The same silent staleness is what the missing Inputs caused
    in the first place, and it cost a long and completely wrong investigation
    during which three edits were each "verified" against a bundle none of them
    had reached.

    Five seconds of vite on a renderer change is a cheap price for a build that
    cannot quietly be lying. tools/verify.mjs checks the deployed bundle against
    the source for the same reason.
  -->
  <Target Name="BuildRenderer" BeforeTargets="Build">
    <Error Condition="!Exists('..\Engine\package.json')"
           Text="Renderer sources were found but src\Engine\package.json is missing. Run 'npm install' in src\Engine." />
    <Exec Command="npm run build" WorkingDirectory="..\Engine" />
  </Target>

  <!--
    The deployment must not be skipped just because the bundle did not need
    rebuilding. Its whole job is to mirror src\Engine\renderer into the output, and
    the output can be stale or missing while the bundle is current: after a
    clean, after switching configuration, or after something else deleted it. So it
    runs on the stale path too, and keeps the loud error below.
  -->
  <Target Name="CopyRendererFiles" AfterTargets="Build" DependsOnTargets="BuildRenderer">
    <ItemGroup>
      <RendererFiles Include="..\Engine\renderer\**\*" />
    </ItemGroup>
    <Error Condition="'@(RendererFiles)' == ''"
           Text="Renderer build produced no files. Expected ..\Engine\renderer to exist. Run 'npm run build' in src/Engine." />
    <RemoveDir Directories="$(TargetDir)renderer" />
    <MakeDir Directories="$(TargetDir)renderer" Condition="!Exists('$(TargetDir)renderer')" />
    <Copy SourceFiles="@(RendererFiles)"
          DestinationFiles="@(RendererFiles->'$(TargetDir)renderer\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
    <Error Condition="!Exists('$(TargetDir)renderer\index.html')"
           Text="Deployed renderer is missing index.html. The host would start and render nothing." />
  </Target>

  <!--
    Same deployment for the publish path, aimed at the publish directory. Kept as
    its own target rather than a condition inside the Build one, because on
    publish $(TargetDir) already points at the publish folder and running the same
    copy twice would be wasted work; this makes the intent explicit and lets a
    publish fail loudly if the renderer is missing.
  -->
  <Target Name="CopyRendererFilesForPublish" AfterTargets="Publish" DependsOnTargets="BuildRenderer">
    <PropertyGroup>
      <!-- $(PublishDir) is not guaranteed to end in a separator, and concatenating
           a path without one silently produces "publish-proberenderer". -->
      <RendererPublishDir>$(PublishDir)</RendererPublishDir>
      <RendererPublishDir Condition="!HasTrailingSlash('$(RendererPublishDir)')">$(RendererPublishDir)\</RendererPublishDir>
    </PropertyGroup>
    <ItemGroup>
      <PublishRendererFiles Include="..\Engine\renderer\**\*" />
    </ItemGroup>
    <Error Condition="'@(PublishRendererFiles)' == ''"
           Text="Renderer build produced no files, so the published application would render nothing. Run 'npm run build' in src/Engine." />
    <MakeDir Directories="$(RendererPublishDir)renderer" />
    <Copy SourceFiles="@(PublishRendererFiles)"
          DestinationFiles="@(PublishRendererFiles->'$(RendererPublishDir)renderer\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
    <Error Condition="!Exists('$(RendererPublishDir)renderer\index.html')"
           Text="Published renderer is missing index.html. The published application would render nothing." />
  </Target>

  <!--
    Record a digest of the deployed renderer so the host can refuse to start on a
    modified install directory. Written after the copy, because the digest has to
    describe what was actually deployed rather than what the build produced.
  -->
  <Target Name="WriteBundleDigest" AfterTargets="CopyRendererFiles">
    <Exec Command="node ..\..\tools\write-bundle-digest.mjs &quot;$(TargetDir)renderer&quot; &quot;$(TargetDir)renderer.bundle.sha256&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          Condition="Exists('..\..\tools\write-bundle-digest.mjs')" />
  </Target>

  <Target Name="WriteBundleDigestForPublish" AfterTargets="CopyRendererFilesForPublish">
    <PropertyGroup>
      <RendererDigestDir>$(PublishDir)</RendererDigestDir>
      <RendererDigestDir Condition="!HasTrailingSlash('$(RendererDigestDir)')">$(RendererDigestDir)\</RendererDigestDir>
    </PropertyGroup>
    <Exec Command="node ..\..\tools\write-bundle-digest.mjs &quot;$(RendererDigestDir)renderer&quot; &quot;$(RendererDigestDir)renderer.bundle.sha256&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          Condition="Exists('..\..\tools\write-bundle-digest.mjs')" />
  </Target>

  <!--
    Application and tray icon. Generated by tools/make-branding.mjs and committed under
    assets/branding, so the mark is versioned with the project rather than drawn at
    startup. The old runtime generator was removed: it rewrote the icon on every
    launch, which meant a build that installed real branding still lost it the
    next time the app ran.
  -->
  <ItemGroup>
    <None Include="..\..\assets\branding\anomaly.ico" Link="anomaly.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
