<Window x:Class="AnomalyEngine.SettingsWindow.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anomaly Engine"
        Height="680" Width="980"
        MinHeight="520" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#0D1014"
        Foreground="#E4E9F0"
        FontFamily="pack://application:,,,/Fonts/Inter-Regular.ttf#Inter"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        SnapsToDevicePixels="True">

    <!--
        The palette is taken from the product rather than from a generic dark
        theme. The accent is the exact phosphor of the observatory terminal
        that sits in every world, so the settings window and the thing it
        configures read as the same object. Everything else is a neutral ink
        scale with checked contrast ratios rather than eyeballed greys.

        The window's own Background and Foreground are duplicated as literals
        above, because an element's attributes are resolved before its own
        Resources are available. Those two values must stay in step with
        BgBrush and TextBrush.
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush"        Color="#0D1014"/>
        <SolidColorBrush x:Key="SurfaceBrush"   Color="#141920"/>
        <SolidColorBrush x:Key="CardBrush"      Color="#181F27"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#1E2731"/>
        <SolidColorBrush x:Key="NavBrush"       Color="#0A0D11"/>
        <SolidColorBrush x:Key="LineBrush"      Color="#232C36"/>
        <SolidColorBrush x:Key="TextBrush"      Color="#E4E9F0"/>
        <SolidColorBrush x:Key="DimBrush"       Color="#94A1B2"/>
        <SolidColorBrush x:Key="FaintBrush"     Color="#6B7887"/>
        <!-- Terminal phosphor. Same value the CRT uses. -->
        <SolidColorBrush x:Key="AccentBrush"    Color="#7EE2A8"/>
        <SolidColorBrush x:Key="AccentDimBrush" Color="#3F7D5C"/>
        <SolidColorBrush x:Key="WarnBrush"      Color="#E0B341"/>
        <SolidColorBrush x:Key="WarnBgBrush"    Color="#1E1A10"/>
        <SolidColorBrush x:Key="WarnLineBrush"  Color="#4A3D18"/>

        <!-- Focus ring. A visible focus indicator on every interactive element:
             this window is fully keyboard reachable and that has to be obvious,
             not just technically present. -->
        <SolidColorBrush x:Key="FocusBrush" Color="#7EE2A8"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation buttons carry an active state so the user always knows
             where they are, rather than having to infer it from the heading. -->
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="10,0,10,2"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="NavButtonActive" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        </Style>

        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="MinHeight" Value="24"/>
        </Style>

        <!--
            A ComboBox's chrome comes from a ControlTemplate, and the default
            template paints itself with system theme brushes. Setting Background,
            Foreground and BorderBrush on the style does nothing without a
            template to consume them, so the two most-used dropdowns in the window
            rendered as default grey Windows controls against a dark phosphor UI.
            This template brings them in line with the buttons.
        -->
        <!--
            Text boxes, which were the one control family the window never themed.

            Three of them carry the whole feed story: the URL you paste, the words a
            rule matches on, and the headline you try against your rules. All three
            were rendering as default white Windows boxes inside a dark interface,
            which put the brightest element on the page exactly where the user is
            meant to be looking.

            A ControlTemplate is required for the same reason the ComboBox needs one:
            setting Background on the style does nothing without a template to consume
            it, so the default template paints over it in system colours.

            PART_ContentHost is what makes this still behave like a text box: it is
            where the caret, the selection highlight and the IME live. A template
            without it renders a convincing box that cannot be typed into, which is a
            worse bug than the default chrome it replaced.
        -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <!-- Selection has to be legible against a dark field. The system default
                 is a near-invisible grey-blue. -->
            <Setter Property="SelectionBrush" Value="{StaticResource AccentDimBrush}"/>
            <Setter Property="SelectionOpacity" Value="0.6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <!--
                                A Border takes a single child, so the hint and the
                                content host share a grid rather than the hint
                                replacing the editor.
                            -->
                            <Grid>
                                <!--
                                    A hint when the field is empty. Kept faint on
                                    purpose: it is guidance, not a value, and it must
                                    never be mistaken for something already typed.
                                -->
                                <TextBlock x:Name="Hint"
                                           Margin="{TemplateBinding Padding}"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{StaticResource FaintBrush}"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"
                                           VerticalAlignment="Center"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--
                                The hint shows only while the field is empty AND not
                                focused: a placeholder sitting under a live caret reads
                                as content, and showing it under typed text reads as a
                                second value. Written as one MultiTrigger rather than a
                                pair of single triggers that fight each other, which is
                                what it was, and which left the hint permanently hidden.
                            -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="IsFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="MinWidth" Value="240"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="26"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                    <!-- Chevron, drawn rather than themed. -->
                                    <Path Grid.Column="1"
                                          Data="M 0 0 L 5 5 L 10 0"
                                          Stroke="{StaticResource TextBrush}"
                                          StrokeThickness="1.5"
                                          StrokeEndLineCap="Round"
                                          StrokeStartLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <!-- The invisible button that actually opens the list. -->
                            <ToggleButton x:Name="PART_Toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   VerticalOffset="4"
                                   PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Padding="4">
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            A Slider paints itself from a ControlTemplate as well. Left to the
            default it renders as a grey Windows track against a dark phosphor
            interface, which is the same defect the ComboBoxes had.
        -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Track -->
                            <Border Height="4" CornerRadius="2" Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"/>
                            <!-- Filled portion, from the left edge to the thumb. -->
                            <Border x:Name="PART_Fill" Height="4" CornerRadius="2"
                                    Background="{StaticResource AccentBrush}" HorizontalAlignment="Left"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid x:Name="Knob">
                                                    <Ellipse Fill="{StaticResource AccentBrush}"/>
                                                    <!-- Focus ring, so the thumb is reachable by keyboard. -->
                                                    <Ellipse x:Name="Ring" Stroke="{StaticResource FocusBrush}"
                                                             StrokeThickness="2" Margin="-3" Opacity="0"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Knob" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="1.15" ScaleY="1.15"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Height" Value="6"/>
        </Style>
    </Window.Resources>

    <!--
        The background lives here, not only on the Window.

        A Window paints its own Background, but this Grid is the root *content*, and
        content has to be able to stand on its own. The settings-page audit renders
        this element directly rather than the Window, because a Window that has never
        been shown has no native handle and rasterises to a blank white image with no
        error anywhere. With the fill living only on the Window, every screenshot of
        the settings window came out as a white page with near-white headings on it,
        which is not what anyone using the application sees.

        Same colour as the Window's own Background, so the running product is
        unchanged and the captures become true.
    -->
    <Grid Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================= NAVIGATION ============================= -->
        <Border Grid.Column="0" Background="{StaticResource NavBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,22,0,16" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="20,0,20,22">
                    <TextBlock Text="ANOMALY ENGINE" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="v0.1" FontSize="11" Margin="0,3,0,0"
                               Foreground="{StaticResource FaintBrush}"/>
                </StackPanel>

                <!--
                    The buttons live in a StackPanel rather than directly in the
                    DockPanel. Undocked DockPanel children are stretched to share
                    the remaining space, which gave each button a slice of the
                    column and clipped every label to a few characters.
                -->
                <StackPanel>
                    <Button x:Name="NavHome"   Content="Home"          Style="{StaticResource NavButton}" Click="BtnHome_Click"/>
                    <Button x:Name="NavWorlds" Content="Worlds"         Style="{StaticResource NavButton}" Click="BtnWorlds_Click"/>
                    <Button x:Name="NavLook"   Content="Appearance"     Style="{StaticResource NavButton}" Click="BtnAppearance_Click"/>
                    <Button x:Name="NavPerf"   Content="Performance"    Style="{StaticResource NavButton}" Click="BtnPerformance_Click"/>
                    <Button x:Name="NavEvents" Content="Events"         Style="{StaticResource NavButton}" Click="BtnEvents_Click"/>
                    <Button x:Name="NavA11y"   Content="Accessibility"  Style="{StaticResource NavButton}" Click="BtnAccessibility_Click"/>
                    <Button x:Name="NavNotes"  Content="Field Notes"    Style="{StaticResource NavButton}" Click="BtnNotes_Click"/>
                    <Button x:Name="NavMon"    Content="Displays"       Style="{StaticResource NavButton}" Click="BtnMonitors_Click"/>
                    <Button x:Name="Net"       Content="Integrations"   Style="{StaticResource NavButton}" Click="BtnIntegrations_Click"/>
                    <Button x:Name="NavAbout"  Content="About"          Style="{StaticResource NavButton}" Click="BtnAbout_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================== CONTENT ============================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="32,26,32,18">
                <TextBlock x:Name="SectionTitle" Text="Home" Style="{StaticResource Title}"/>
                <TextBlock x:Name="SectionBlurb" Text="" Style="{StaticResource Note}" Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,0">
                <StackPanel>

                    <!-- ============================ HOME ============================ -->
                    <StackPanel x:Name="HomeSection">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="StatusWorldText" Text="Reading engine..."
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="StatusPerfText" Text="" Margin="0,6,0,0"
                                               Style="{StaticResource Note}"/>
                                    <TextBlock x:Name="StatusQualityText" Text="" Style="{StaticResource Note}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource BgBrush}"
                                        CornerRadius="4" Padding="10,6" VerticalAlignment="Top">
                                    <TextBlock Text="LIVE" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource Heading}" Text="CONTROLS"/>
                        <WrapPanel>
                            <Button x:Name="PauseButton" Content="Pause" Click="BtnPause_Click"/>
                            <Button x:Name="ResumeButton" Content="Resume" Click="BtnResume_Click" IsEnabled="False"/>
                            <Button Content="Next world" Click="BtnNextWorld_Click"/>
                            <Button Content="Trigger an event" Click="BtnTriggerEvent_Click"/>
                            <Button Content="Field notes" Click="BtnOpenNotes_Click"/>
                            <Button Content="Debug overlay" Click="BtnDebug_Click"/>
                        </WrapPanel>

                        <TextBlock Style="{StaticResource Heading}" Text="GLOBAL HOTKEYS" Margin="0,24,0,6"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="A wallpaper never holds keyboard focus, so these are registered system-wide with Windows."/>
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <UniformGrid Columns="2">
                                <TextBlock Text="Ctrl+Alt+W" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" Margin="0,3"/>
                                <TextBlock Text="Next world" Margin="0,3"/>
                                <TextBlock Text="Ctrl+Alt+S" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" Margin="0,3"/>
                                <TextBlock Text="Cycle art style" Margin="0,3"/>
                                <TextBlock Text="Ctrl+Alt+P" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" Margin="0,3"/>
                                <TextBlock Text="Pause / resume" Margin="0,3"/>
                                <TextBlock Text="Ctrl+Alt+F" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" Margin="0,3"/>
                                <TextBlock Text="Field notes" Margin="0,3"/>
                                <TextBlock Text="Ctrl+Alt+D" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" Margin="0,3"/>
                                <TextBlock Text="Debug overlay" Margin="0,3"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>

                    <!-- =========================== WORLDS =========================== -->
                    <StackPanel x:Name="WorldsSection" Visibility="Collapsed">
                        <TextBlock x:Name="WorldCountText" Style="{StaticResource Note}" Margin="0,0,0,14"/>

                        <ItemsControl x:Name="WorldList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Import world..." Click="BtnImportWorld_Click"/>
                            <Button Content="Open data folder" Click="BtnOpenFolder_Click"/>
                            <Button Content="Refresh" Click="BtnRefresh_Click"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                                   Text="A world is data, not artwork: a biome, a palette, a terrain profile and a list of structures. The renderer generates every pixel, so an imported world carries no third-party art and no licence obligations."/>

                        <!--
                            Integrity notice. Shown when an imported world no longer
                            matches the checksum recorded when it was first imported.
                            A digest is a checksum for "this file changed", not a
                            cryptographic guarantee, so this reports a change and
                            lets the user accept it; it never blocks their own file.
                        -->
                        <Border x:Name="WorldChangedPanel"
                                Background="{StaticResource WarnBgBrush}"
                                BorderBrush="{StaticResource WarnLineBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,16,0,0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="An imported world has changed" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource WarnBrush}"/>
                                <TextBlock x:Name="WorldChangedText" Style="{StaticResource Note}" Margin="0,4,0,0"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Accept these changes" Click="BtnAcceptWorldChanges_Click"/>
                                    <Button Content="Open data folder" Click="BtnOpenFolder_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================= APPEARANCE ========================= -->
                    <StackPanel x:Name="AppearanceSection" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Heading}" Text="ART STYLE"/>
                        <ComboBox x:Name="StyleCombo" SelectionChanged="StyleCombo_SelectionChanged" SelectedIndex="0">
                            <ComboBoxItem>Painterly</ComboBoxItem>
                            <ComboBoxItem>Flat</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="All three are complete renderer treatments rather than filters over one image, and each is designed to hold up across the whole day and night cycle."/>

                        <TextBlock Style="{StaticResource Heading}" Text="MOTION" Margin="0,28,0,10"/>
<CheckBox x:Name="ReducedMotion" Content="Follow the Windows reduce-motion setting"
   Checked="ReducedMotion_Checked" Unchecked="ReducedMotion_Unchecked"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Follows the Windows reduce-motion setting when first enabled. This surface can run for hours at a time, so constant drift is a real accessibility concern rather than a preference."/>

                        <!--
                            Motion level.

                            Present because the scene contains several independently
                            animating things, and asking someone to have an opinion
                            about each of them is not a reasonable thing to ask. One
                            dial sets the overall level and the renderer decides how
                            much each kind of motion gives up, which is the point,
                            because turning motion down should calm the scene rather
                            than freeze it.

                            Values are the ones the renderer documents as calm and
                            lively, not an arbitrary 0-100.
                        -->
                        <TextBlock Style="{StaticResource Heading}" Text="MOTION LEVEL" Margin="0,26,0,0"/>
                        <TextBlock x:Name="MotionHintText" Style="{StaticResource Note}"
                                   Text="How much of the scene moves."/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Slider x:Name="MotionSlider" Width="320" Minimum="0" Maximum="100"
                                    IsSnapToTickEnabled="True" TickFrequency="5" TickPlacement="BottomRight"
                                    Thumb.DragStarted="MotionSlider_DragStarted"
                                    Thumb.DragCompleted="MotionSlider_DragCompleted"
                                    ValueChanged="MotionSlider_ValueChanged"/>
                            <TextBlock x:Name="MotionValueText" Margin="14,0,0,0" VerticalAlignment="Center"
                                       FontSize="13" Foreground="{StaticResource AccentBrush}" MinWidth="86"/>
                        </StackPanel>
                        <TextBlock x:Name="MotionReducedNote" Style="{StaticResource Note}" Margin="0,6,0,0"
                                   Visibility="Collapsed"
                                   Text="Windows reduce-motion is on, so this is capped low regardless of the setting."/>
                        <!--
                            Distinct from the note above, and the difference matters.
                            That one says the operating system has asked for calm. This
                            one says your slider position is not the one being used, and
                            by how much. Without it the slider looks broken rather than
                            constrained, which is the impression you get when a control
                            quietly discards what you did to it.
                        -->
                        <TextBlock x:Name="MotionCappedNote" Style="{StaticResource Note}"
                                   Margin="0,4,0,0" Visibility="Collapsed"
                                   Foreground="{StaticResource WarnBrush}"
                                   Text="Reduced motion is capping the scene below this setting."/>
                    </StackPanel>

                    <!-- ======================= ACCESSIBILITY ======================= -->
                    <!--
                        Five controls that had nowhere to live.

                        Each of these was a field on the renderer's accessibility
                        config, set by nothing, read by nothing, and reported to
                        nobody: high contrast, mute, keyboard navigation, enlarged
                        interface text, and visible focus outlines. Two of them
                        toggled a class name on the document root, in a project
                        with no stylesheet, which is why they looked implemented
                        and were not.

                        The one preference that already had a control (Windows
                        reduce-motion) stays on Appearance, next to the motion
                        slider it caps, rather than being duplicated here. A
                        checkbox that exists in two places and is remembered in one
                        is a checkbox that will eventually disagree with itself.
                    -->
                    <StackPanel x:Name="AccessibilitySection" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Heading}" Text="CONTRAST"/>
                        <CheckBox x:Name="HighContrastBox" Content="Higher contrast"
                                  Checked="HighContrast_Checked" Unchecked="HighContrast_Unchecked"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Removes the film grain, flattens the shading, and stops the panels from being translucent over whatever the wallpaper happens to be showing. A wallpaper behind glass has no guaranteed contrast ratio, so this is the setting that makes the text readable rather than merely dark."/>

                        <TextBlock Style="{StaticResource Heading}" Text="SOUND" Margin="0,28,0,10"/>
                        <CheckBox x:Name="MuteAllBox" Content="Mute everything"
                                  Checked="MuteAll_Checked" Unchecked="MuteAll_Unchecked"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Stops any track and silences the mixer. Nothing resumes by itself when this is unticked: a wallpaper that starts making noise with no visible cause is worse than one that stays quiet."/>

                        <TextBlock Style="{StaticResource Heading}" Text="KEYBOARD" Margin="0,28,0,10"/>
                        <CheckBox x:Name="KeyboardNavBox" Content="Keyboard control of the panels"
                                  Checked="KeyboardNav_Checked" Unchecked="KeyboardNav_Unchecked"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Escape closes whatever panel is open, and Tab stays inside it instead of walking off onto the desktop underneath. There is nothing to click here, so without this the field notes panel cannot be closed at all until its timer runs out."/>

                        <CheckBox x:Name="FocusVisibleBox" Content="Always show the focus outline" Margin="0,16,0,0"
                                  Checked="FocusVisible_Checked" Unchecked="FocusVisible_Unchecked"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Draws a focus ring on whatever the keyboard is on. The panels sit over a WebGL canvas showing an arbitrary world, so the ring is drawn explicitly rather than left to whatever the browser would pick against an unknown background."/>

                        <TextBlock Style="{StaticResource Heading}" Text="TEXT SIZE" Margin="0,28,0,10"/>
                        <CheckBox x:Name="ScalableUiBox" Content="Enlarge the interface text"
                                  Checked="ScalableUi_Checked" Unchecked="ScalableUi_Unchecked"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Scales the field notes and creator panels by 25%. It is a multiplier rather than a fixed size, so it composes with the browser zoom you already use instead of overriding it."/>
                        <TextBlock x:Name="UiScaleText" Style="{StaticResource Note}" Margin="0,6,0,0"
                                   Text="Currently 1.00x."/>
                    </StackPanel>

                    <!-- ======================== PERFORMANCE ========================= -->
                    <StackPanel x:Name="PerformanceSection" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Heading}" Text="FRAME RATE CAP"/>
                        <ComboBox x:Name="FpsCombo" SelectionChanged="FpsCombo_SelectionChanged" SelectedIndex="1">
                            <ComboBoxItem>30 fps</ComboBoxItem>
                            <ComboBoxItem>60 fps</ComboBoxItem>
                            <ComboBoxItem>120 fps</ComboBoxItem>
                            <ComboBoxItem>Unlimited</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="A desktop background gains nothing from repainting at display rate, and capping is the cheapest way to leave a laptop fan alone."/>

                        <TextBlock Style="{StaticResource Heading}" Text="RENDER QUALITY" Margin="0,28,0,10"/>
                        <ComboBox x:Name="QualityCombo" SelectionChanged="QualityCombo_SelectionChanged" SelectedIndex="3">
                            <ComboBoxItem>Low (60%)</ComboBoxItem>
                            <ComboBoxItem>Medium (80%)</ComboBoxItem>
                            <ComboBoxItem>High (100%)</ComboBoxItem>
                            <ComboBoxItem>Automatic</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Automatic adapts the render scale to hold a frame budget. The scene is drawn to an offscreen buffer and blitted up, so slower hardware gets a cheaper frame without the wallpaper visibly resizing."/>

                        <TextBlock Style="{StaticResource Heading}" Text="MEASURED NOW" Margin="0,28,0,10"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="PerfFpsText" Text="—"/>
                                <TextBlock x:Name="PerfRenderScaleText" Text="—" Style="{StaticResource Note}"/>
                                <TextBlock x:Name="PerfFrameTimeText" Text="—" Style="{StaticResource Note}"/>
                            </StackPanel>
                        </Border>
                        <Button Content="Open debug overlay" Click="BtnDebug_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    </StackPanel>

                    <!-- =========================== EVENTS =========================== -->
                    <StackPanel x:Name="EventsSection" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Heading}" Text="REGISTERED ANOMALIES"/>
                        <TextBlock Style="{StaticResource Note}" Margin="0,0,0,10"
                                   Text="Every effect the engine can draw and a feed can select, read from the engine's own registry. Map a headline onto one from the Integrations page."/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="AnomalyCountText" Text="" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock x:Name="AnomalyListText" Text="" Style="{StaticResource Note}" Margin="0,8,0,0"/>
                                <!--
                                    Populated at runtime from the registry, so it cannot
                                    describe an effect the engine does not ship, and
                                    cannot omit one it does.
                                -->
                                <StackPanel x:Name="EffectReferencePanel" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Heading}" Text="TRIGGER" Margin="0,28,0,10"/>
                        <WrapPanel>
                            <Button Content="Trigger a world-appropriate event" Click="BtnTriggerEvent_Click"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Note}" Margin="0,6,0,0"
                                   Text="Anomalies carry rarity and cooldowns, and are scoped to biomes and structures: an event that needs an observatory will not fire in a world without one, and the engine substitutes one that fits rather than showing nothing."/>
                        <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0"
                                   Text="Show in the world plays one effect once so you can see what a rule would cause. It is never recorded to the journal, never written to disk, and expires on its own. The engine's own events stay rare and unscheduled; this only runs because you asked it to."/>
                    </StackPanel>

                    <!-- ========================= FIELD NOTES ========================= -->
                    <StackPanel x:Name="NotesSection" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Heading}" Text="WHAT IS RECORDED"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="NotesCountText" Text="" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock x:Name="NotesListText" Text="" Style="{StaticResource Note}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <WrapPanel Margin="0,20,0,0">
                            <Button Content="Open field notes" Click="BtnOpenNotes_Click"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Note}" Margin="0,6,0,0"
                                   Text="Everything is stored locally in a single JSON file. No account, no telemetry, and nothing leaves the machine. Every observation is recorded alongside a plausible explanation, so anything you think you saw stays dismissible."/>
                    </StackPanel>

                    <!-- ========================== DISPLAYS ========================== -->
                    <StackPanel x:Name="MonitorsSection" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Heading}" Text="ATTACHED DISPLAYS"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="MonitorCountText" Text="Detecting..."
                                           Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock x:Name="MonitorListText" Text="" Style="{StaticResource Note}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!--
                            Per-display worlds. Populated at runtime, one row per
                            attached display, because the number of displays is not
                            known until the host reports them and hard-coding two
                            rows would be wrong on every machine except the one it
                            was written on.
                        -->
                        <TextBlock Style="{StaticResource Heading}" Text="WORLD PER DISPLAY"
                                   Margin="0,26,0,0"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Give each screen its own place. Left on the active world, a display follows whatever world is selected."/>
                        <StackPanel x:Name="DisplayWorldPanel" Margin="0,12,0,0"/>
                        <Button x:Name="ClearDisplayWorlds" Content="Reset all displays to the active world"
                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                Visibility="Collapsed" Click="BtnClearDisplayWorlds_Click"/>
                        <Border Background="{StaticResource WarnBgBrush}" BorderBrush="{StaticResource WarnLineBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="The terminal is on the primary only" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource WarnBrush}"/>
                                <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0"
                                           Text="Every attached display is composed independently, so a mixed setup gets a correct aspect ratio on each screen rather than one wide crop split across them. The observatory terminal is drawn on the primary only, as one piece of equipment standing in the world rather than something installed on every screen."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================== INTEGRATIONS ======================== -->
                    <StackPanel x:Name="IntegrationsSection" Visibility="Collapsed">
                        <!--
                            Event feeds.

                            Three things are worth knowing before adding one, and all
                            three are enforced in code rather than here:

                            The engine cannot fetch anything itself. The page is served
                            from file:// and its content security policy sets connect-src
                            to none, so the renderer never touches the network. The host
                            reads the document and hands over text, which means the
                            page's "no network access" claim is a property of the
                            product and not a setting.

                            A feed does nothing until a rule says what it should do.
                            There is no default mapping, so a newly added feed is silent
                            until you tell it which words in a headline map to which of
                            the six effects. That is deliberate: a feed that started
                            firing something the moment it was added would be one
                            nobody could predict.

                            A feed can only select one of six registered effects. It
                            cannot supply a duration, a colour, a command or a payload,
                            because those are not in the type it is matched against.
                        -->
                        <TextBlock Style="{StaticResource Heading}" Text="EVENT FEEDS"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Point the engine at an RSS or Atom feed, or at a JSON feed, and say which words in a headline should cause which effect. The document is read by the host, never by the page, and only https is accepted. Nothing is sent back."/>

                        <TextBlock x:Name="FeedEmptyNote" Style="{StaticResource Note}"
                                Margin="0,12,0,0" Text="No feeds configured."/>

                        <!--
                            The cards are built in code rather than bound, because each
                            one now carries working controls: a rule list with removes, an
                            effect picker fed by the renderer's registry, an enable toggle
                            that actually writes, and a tester that answers "would this
                            headline match". A data template with four click handlers in
                            it would be harder to keep correct than the construction, and
                            the closures there already hold the feed's own id.
                        -->
                        <ItemsControl x:Name="FeedList" Margin="0,12,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBox x:Name="FeedUrlBox" Width="360" VerticalAlignment="Center"
                                     Tag="https://example.com/feed.xml"
                                     ToolTip="An https URL. Plain http is accepted on localhost only."/>
                            <Button x:Name="AddFeedUrlButton" Content="Add URL" Padding="14,6" Margin="10,0,0,0"
                                    Click="AddFeedUrl_Click" VerticalAlignment="Center"/>
                            <Button x:Name="TryDocumentButton" Content="Try a document..." Padding="14,6" Margin="10,0,0,0"
                                    Click="TryDocument_Click" VerticalAlignment="Center"
                                    ToolTip="Test your rules against a document on this machine. Nothing is fetched and nothing is triggered."/>
                            <Button x:Name="ClearFeedsButton" Content="Remove all" Padding="14,6"
                                    Margin="10,0,0,0" Click="ClearFeeds_Click" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="FeedStatusText" Style="{StaticResource Note}"
                                   Margin="0,8,0,0" Text=""/>

                        <TextBlock Style="{StaticResource Heading}" Text="WEATHER" Margin="0,28,0,10"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Weather runs from a local simulation seeded by latitude and longitude. No API key is used and no request leaves the machine, so the desktop behaves consistently offline and nothing about the user's location is disclosed."/>

                        <TextBlock Style="{StaticResource Heading}" Text="LANGUAGE" Margin="0,28,0,10"/>
                        <TextBlock Style="{StaticResource Note}" Margin="0,0,0,10"
                                   Text="The desktop follows your system language on first run. This overrides it. The field notes, the creator panel and the hover hints are translated; the world names and the anomaly names are not, because they are the fiction rather than the interface around it."/>
                        <ComboBox x:Name="LanguageBox" SelectionChanged="LanguageBox_SelectionChanged" HorizontalAlignment="Left" MinWidth="200"/>

                        <!--
                            Audio reactivity.

                            The engine reacts to a file on this machine, and never to
                            what is playing on the system. Capturing desktop audio
                            needs a loopback device and a permission granted through
                            a picker, and a wallpaper is the last thing that should be
                            asking for either. A file is explicit, works offline, and
                            carries no licence question, which is why this is here
                            rather than a microphone permission prompt.

                            The analysis is real: transients are found per band against
                            a local median, so a held note does not produce a beat
                            train and a quiet passage before a loud one is still heard.
                            The engine tests assert that against a synthesised click
                            track.
                        -->
                        <TextBlock Style="{StaticResource Heading}" Text="AUDIO REACTIVITY" Margin="0,28,0,10"/>
                        <CheckBox x:Name="AudioReactiveBox" Content="Let the sky respond to an audio track"
                                  Checked="AudioReactive_Checked" Unchecked="AudioReactive_Unchecked"/>
                        <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0"
                                   Text="Off by default. The file is read locally and never leaves the machine."/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="PickTrackButton" Content="Choose a track..." Padding="14,6"
                                    Click="PickTrack_Click" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TrackPathText" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Note}" Text="No track chosen."/>
                        </StackPanel>
                        <CheckBox x:Name="AudioSilentBox" Content="Analyse it without playing it" Margin="0,14,0,0"
                                  Checked="AudioSilent_Checked" Unchecked="AudioSilent_Unchecked"/>
                        <TextBlock x:Name="MediaBeatText" Style="{StaticResource Note}" Margin="0,6,0,0" Text=""/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Muting from the Accessibility page silences the track immediately. Reduced motion keeps the response but drops it to a quarter, because a sky that flares on every beat is a strobe and strobes are the one thing on this surface that is genuinely dangerous for some people."/>
                    </StackPanel>

                    <!-- ============================= ABOUT ============================= -->
                    <StackPanel x:Name="AboutSection" Visibility="Collapsed">
                        <TextBlock Text="Anomaly Engine" Style="{StaticResource Title}"/>
                        <TextBlock Text="v0.1.0" Style="{StaticResource Note}" Margin="0,4,0,20"/>

                        <TextBlock Style="{StaticResource Heading}" Text="WHAT THIS IS"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="A live wallpaper engine where the desktop behaves like a living world: a seeded procedural landscape that changes with the real time of day and weather, with a quiet observatory terminal that occasionally reports something the place could plausibly explain away."/>

                        <TextBlock Style="{StaticResource Heading}" Text="ARTWORK AND LICENSING" Margin="0,28,0,10"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="This project ships zero third-party art. Every pixel is generated at runtime from seeded noise, so there is no asset licence to inherit and no way for a bundled file to carry terms the project would have to honour. A machine-checked gate enforces the policy if that ever changes."/>

                        <TextBlock Style="{StaticResource Heading}" Text="PRIVACY" Margin="0,28,0,10"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="No account, no analytics, no advertising, and no screenshot ever leaves the machine. Discovery history is a local file you can read and delete."/>

                        <TextBlock Style="{StaticResource Heading}" Text="NAMING" Margin="0,28,0,10"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="A rename is under consideration; docs/NAMING.md in the repository records the reasoning and the options."/>

                        <TextBlock Style="{StaticResource Heading}" Text="CREDITS" Margin="0,28,0,10"/>
                        <TextBlock Style="{StaticResource Note}" Text="Ali S. (@realizations). MIT licensed."/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Status bar. Doubles as the live region for action feedback, so
                 screen readers announce results rather than changes being
                 silent. -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="32,10">
                <TextBlock x:Name="StatusText" Text="" Style="{StaticResource Note}"
                           AutomationProperties.LiveSetting="Polite"/>
            </Border>
        </Grid>
    </Grid>
</Window>
