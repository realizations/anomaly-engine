<Window x:Class="AnomalyEngine.SettingsWindow.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anomaly Engine Settings"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e"
        Foreground="#e0e0ff"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2a2a4e"/>
            <Setter Property="Foreground" Value="#e0e0ff"/>
            <Setter Property="BorderBrush" Value="#4a4a8e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3a3a6e"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1a1a2e"/>
            <Setter Property="Foreground" Value="#8888aa"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#e0e0ff"/>
                    <Setter Property="Background" Value="#2a2a4e"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#e0e0ff"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Background" Value="#2a2a4e"/>
            <Setter Property="Foreground" Value="#8888ff"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#e0e0ff"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2a2a4e"/>
            <Setter Property="Foreground" Value="#e0e0ff"/>
            <Setter Property="BorderBrush" Value="#4a4a8e"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#12122a" BorderBrush="#2a2a4e" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,20">
                <TextBlock Text="ANOMALY ENGINE" FontSize="16" FontWeight="Bold" Margin="16,0,16,20" Foreground="#8888ff"/>

                <Button x:Name="BtnHome" Content="Home" HorizontalContentAlignment="Left" Click="BtnHome_Click"/>
                <Button x:Name="BtnWorlds" Content="Worlds" HorizontalContentAlignment="Left" Click="BtnWorlds_Click"/>
                <Button x:Name="BtnAppearance" Content="Appearance" HorizontalContentAlignment="Left" Click="BtnAppearance_Click"/>
                <Button x:Name="BtnPerformance" Content="Performance" HorizontalContentAlignment="Left" Click="BtnPerformance_Click"/>
                <Button x:Name="BtnEvents" Content="Events" HorizontalContentAlignment="Left" Click="BtnEvents_Click"/>
                <Button x:Name="BtnAudio" Content="Audio" HorizontalContentAlignment="Left" Click="BtnAudio_Click"/>
                <Button x:Name="BtnMonitors" Content="Monitors" HorizontalContentAlignment="Left" Click="BtnMonitors_Click"/>
                <Button x:Name="BtnIntegrations" Content="Integrations" HorizontalContentAlignment="Left" Click="BtnIntegrations_Click"/>
                <Button x:Name="BtnSecrets" Content="Secrets" HorizontalContentAlignment="Left" Click="BtnSecrets_Click"/>
                <Button x:Name="BtnAbout" Content="About" HorizontalContentAlignment="Left" Click="BtnAbout_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="SectionTitle" Text="Home" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="#e0e0ff"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ContentPanel">

                    <StackPanel x:Name="HomeSection">
                        <TextBlock Text="Current World" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="The Town That Wasn't There" FontSize="14" Foreground="#8888ff" Margin="0,0,0,16"/>

                        <TextBlock Text="Status" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Running" Foreground="#44cc88" Margin="0,0,0,16"/>

                        <TextBlock Text="Performance" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="60 FPS | 12 MB | Low CPU" Foreground="#8888aa" Margin="0,0,0,16"/>

                        <TextBlock Text="Quick Controls" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Pause" Click="BtnPause_Click"/>
                            <Button Content="Resume" Click="BtnResume_Click"/>
                            <Button Content="Next World" Click="BtnNextWorld_Click"/>
                            <Button Content="Trigger Event" Click="BtnTriggerEvent_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="WorldsSection" Visibility="Collapsed">
                        <TextBlock Text="Installed Worlds" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Border Background="#2a2a4e" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="The Town That Wasn't There" FontWeight="SemiBold"/>
                                    <TextBlock Text="By Ali S. | v1.0.0" Foreground="#8888aa" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Activate" Click="BtnActivateWorld_Click"/>
                                    <Button Content="Preview" Click="BtnPreviewWorld_Click"/>
                                    <Button Content="Delete" Click="BtnDeleteWorld_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Button Content="Import World" Click="BtnImportWorld_Click"/>
                        <Button Content="Open Worlds Folder" Click="BtnOpenFolder_Click"/>
                    </StackPanel>

                    <StackPanel x:Name="PerformanceSection" Visibility="Collapsed">
                        <TextBlock Text="FPS Limit" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ComboBox x:Name="FpsCombo" Width="200" HorizontalAlignment="Left" SelectedIndex="1">
                            <ComboBoxItem>30 FPS</ComboBoxItem>
                            <ComboBoxItem>60 FPS</ComboBoxItem>
                            <ComboBoxItem>120 FPS</ComboBoxItem>
                            <ComboBoxItem>Unlimited</ComboBoxItem>
                        </ComboBox>

                        <TextBlock Text="Quality Preset" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <ComboBox x:Name="QualityCombo" Width="200" HorizontalAlignment="Left" SelectedIndex="2">
                            <ComboBoxItem>Low</ComboBoxItem>
                            <ComboBoxItem>Medium</ComboBoxItem>
                            <ComboBoxItem>High</ComboBoxItem>
                            <ComboBoxItem>Ultra</ComboBoxItem>
                            <ComboBoxItem>Custom</ComboBoxItem>
                        </ComboBox>

                        <TextBlock Text="Options" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <CheckBox x:Name="ChkFullscreenPause" Content="Pause when fullscreen application detected"/>
                        <CheckBox x:Name="ChkBatteryPause" Content="Pause on battery power"/>
                        <CheckBox x:Name="ChkDynamicQuality" Content="Dynamic quality adjustment"/>
                        <CheckBox x:Name="ChkIdleReduce" Content="Reduce animation when idle"/>
                    </StackPanel>

                    <StackPanel x:Name="EventsSection" Visibility="Collapsed">
                        <TextBlock Text="Event Sources" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ChkClockEvents" Content="Clock events (hourly, midnight, special times)" IsChecked="True"/>
                        <CheckBox x:Name="ChkRandomEvents" Content="Random events (meteors, creatures, lights)" IsChecked="True"/>
                        <CheckBox x:Name="ChkWeatherEvents" Content="Weather events (rain, storm, fog)" IsChecked="True"/>
                        <CheckBox x:Name="ChkSystemEvents" Content="System events (sleep, wake, fullscreen)" IsChecked="True"/>
                        <CheckBox x:Name="ChkNetworkEvents" Content="Network events (online, offline)" IsChecked="True"/>
                        <CheckBox x:Name="ChkGitHubEvents" Content="GitHub events (commits, releases, issues)"/>
                        <CheckBox x:Name="ChkRSSEvents" Content="RSS feed events"/>
                        <CheckBox x:Name="ChkRemoteEvents" Content="Remote event feed"/>

                        <TextBlock Text="Rarity" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <CheckBox x:Name="ChkRareEvents" Content="Allow rare events" IsChecked="True"/>
                        <CheckBox x:Name="ChkVeryRareEvents" Content="Allow very rare events" IsChecked="True"/>
                        <CheckBox x:Name="ChkLegendaryEvents" Content="Allow legendary events" IsChecked="True"/>
                    </StackPanel>

                    <StackPanel x:Name="IntegrationsSection" Visibility="Collapsed">
                        <TextBlock Text="Weather" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ComboBox x:Name="WeatherProvider" Width="300" HorizontalAlignment="Left">
                            <ComboBoxItem>OpenWeatherMap</ComboBoxItem>
                            <ComboBoxItem>WeatherAPI</ComboBoxItem>
                            <ComboBoxItem>Custom</ComboBoxItem>
                        </ComboBox>
                        <TextBox x:Name="WeatherApiKey" Width="300" HorizontalAlignment="Left" Margin="0,4" Background="#2a2a4e" Foreground="#e0e0ff" BorderBrush="#4a4a8e" Padding="6"/>

                        <TextBlock Text="GitHub" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <TextBox x:Name="GitHubUsername" Width="300" HorizontalAlignment="Left" Margin="0,4" Background="#2a2a4e" Foreground="#e0e0ff" BorderBrush="#4a4a8e" Padding="6" Text="realizations"/>

                        <TextBlock Text="Remote Event Feed" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <TextBox x:Name="RemoteEventUrl" Width="300" HorizontalAlignment="Left" Margin="0,4" Background="#2a2a4e" Foreground="#e0e0ff" BorderBrush="#4a4a8e" Padding="6"/>
                    </StackPanel>

                    <StackPanel x:Name="SecretsSection" Visibility="Collapsed">
                        <TextBlock Text="Discovered Anomalies" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="0 / 5 discovered" Foreground="#8888aa" Margin="0,0,0,16"/>

                        <TextBlock Text="Journal" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="No entries yet. Start observing." Foreground="#8888aa" Margin="0,0,0,16"/>

                        <TextBlock Text="Progress" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ProgressBar Value="0" Maximum="100" Height="8" Background="#2a2a4e" Foreground="#8888ff"/>
                    </StackPanel>

                    <StackPanel x:Name="AboutSection" Visibility="Collapsed">
                        <TextBlock Text="Anomaly Engine" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="v0.1.0" Foreground="#8888aa" Margin="0,0,0,16"/>
                        <TextBlock Text="A live wallpaper engine where the desktop behaves like a living world." TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <TextBlock Text="By Ali S. (@realizations)" Foreground="#8888ff" Margin="0,0,0,16"/>
                        <TextBlock Text="MIT License" Foreground="#8888aa"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
